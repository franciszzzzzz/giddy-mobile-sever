import expandIntent from "./ai/rag/query/expandIntent.js";
import { INTENTS } from "./ai/constants/intents.js";

console.log("=== Testing expandIntent memory fix ===\n");

// Test 1: Brand search (brand mentioned in query)
const test1 = {
  type: INTENTS.PRODUCT_INFORMATION,
  query: "Sahib",
  brand: { id: 123, name: "Sahiib", slug: "sahiib" },
};

const result1 = expandIntent(test1);
console.log("Test 1: Brand mentioned in query");
console.log("Input query:", test1.query);
console.log("Expanded query:", result1.expandedQuery);
console.log("");

// Test 2: Memory-inherited brand NOT in query
const test2 = {
  type: INTENTS.PRODUCT_RECOMMENDATION,
  query: "Recommend a gift for my dad",
  brand: { id: 123, name: "Sahiib", slug: "sahiib" }, // inherited from memory
  recipient: "dad",
};

const result2 = expandIntent(test2);
console.log("Test 2: Brand inherited from memory, NOT in query");
console.log("Input query:", test2.query);
console.log("Expanded query:", result2.expandedQuery);
console.log("Searches:", JSON.stringify(result2.searches, null, 2));
console.log("");

